<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText android:id="@+id/etDistance"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Дистанция до цели, м"
        android:inputType="numberDecimal" />

    <EditText android:id="@+id/etHeight"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Перепад высот (+ если цель выше), м"
        android:inputType="numberSigned|numberDecimal" />

    <Button android:id="@+id/btnCalc"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Рассчитать" />

    <TextView android:id="@+id/tvResult"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="22sp" android:textStyle="bold"
        android:text="—" />
</LinearLayout>